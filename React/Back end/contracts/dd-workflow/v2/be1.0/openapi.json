    },
    "responses": {
      "CreateCase": { "description": "Created or an idempotent replay of the original 201 response", "headers": { "Idempotent-Replay": { "$ref": "#/components/headers/IdempotentReplay" }, "X-FS-DD-Contract-Version": { "$ref": "#/components/headers/ContractVersion" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "mutation.schema.json#/$defs/CreateCaseResponse" }, "examples": { "created": { "externalValue": "fixtures/create-case-response.json" } } } } },
      "IntakeMutation": { "description": "Intake replacement result", "headers": { "Idempotent-Replay": { "$ref": "#/components/headers/IdempotentReplay" }, "X-FS-DD-Contract-Version": { "$ref": "#/components/headers/ContractVersion" }, "Cache-Control": { "$ref": "#/components/headers/CacheControl" } }, "content": { "application/json": { "schema": { "$ref": "mutation.schema.json#/$defs/IntakeMutationResponse" }, "examples": { "changed": { "externalValue": "fixtures/intake-changed-response.json" }, "noop": { "externalValue": "fixtures/intake-noop-response.json" } } } } },
