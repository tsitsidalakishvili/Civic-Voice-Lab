    "parameters": {
      "CaseId": { "name": "caseId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "CandidateCaseId": { "name": "candidateCaseId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1 } },
      "PurposeId": { "name": "X-FS-Purpose-Id", "in": "header", "required": true, "schema": { "type": "string", "minLength": 2 }, "description": "Must equal the request processingPurposeId for create/intake replacement and an authorized current purpose for other mutations." },
      "CsrfToken": { "name": "X-FS-CSRF", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16 }, "description": "CSRF token bootstrapped from GET /auth/me. Exact Origin or Referer validation is also enforced by shared auth middleware." },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 12, "maxLength": 200, "pattern": "^[!-~]+$" } }
    },
    "headers": {
      "IdempotentReplay": { "description": "true only when the original stored response is replayed", "schema": { "type": "boolean" } },
      "ContractVersion": { "description": "Read contract marker", "schema": { "const": "dd-workflow.v2" } },
      "CacheControl": { "description": "Responses are not shared-cacheable", "schema": { "const": "no-store" } }
    },
    "requestBodies": {
