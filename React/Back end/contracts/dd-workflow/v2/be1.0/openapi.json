      "IntakeReplace": { "required": true, "content": { "application/json": { "schema": { "$ref": "mutation.schema.json#/$defs/IntakeReplaceRequest" }, "examples": { "synthetic": { "externalValue": "fixtures/replace-intake-request.json" } } } } },
      "DuplicateScan": { "required": true, "content": { "application/json": { "schema": { "$ref": "mutation.schema.json#/$defs/DuplicateScanRequest" }, "examples": { "synthetic": { "externalValue": "fixtures/duplicate-scan-request.json" } } } } },
      "DuplicateDecision": { "required": true, "content": { "application/json": { "schema": { "$ref": "mutation.schema.json#/$defs/DuplicateDecisionRequest" }, "examples": { "synthetic": { "externalValue": "fixtures/duplicate-decision-request.json" } } } } },
