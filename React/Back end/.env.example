DELIBERATION_DB_MODE=local
DELIBERATION_NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
DELIBERATION_NEO4J_USER=<instance>
DELIBERATION_NEO4J_USERNAME=<instance>
DELIBERATION_NEO4J_PASSWORD=<password>
DELIBERATION_NEO4J_DATABASE=<instance>

NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USER=<instance>
NEO4J_USERNAME=<instance>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<instance>

CORS_ORIGINS=https://fs-frontend-puce.vercel.app
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

WHATSAPP_GROUP_WEBHOOK_URL=https://your-webhook.example/whatsapp
WHATSAPP_GROUP_WEBHOOK_TOKEN=optional-token

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook
SLACK_USERNAME=FreedomSquareCRM
SLACK_CHANNEL=#fs

GOOGLE_MAPS_API_KEY=your-google-maps-key
GOOGLE_MAPS_GEOCODE_URL=https://maps.googleapis.com/maps/api/geocode/json
CRM_GEOCODE_STRATEGY=always
CRM_GEOCODE_MAX_PER_REQUEST=25
CRM_GEOCODE_TIMEOUT_S=4
CRM_GEOCODE_CITY_HINT=Tbilisi, Georgia

FEEDBACK_EMAIL_FROM=feedback@example.org
FEEDBACK_EMAIL_TO=team@example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=optional-user
SMTP_PASSWORD=optional-password
SMTP_USE_TLS=true

# Audience Discovery Engine (optional)
EMBEDDINGS_API_URL=https://api.example.com/v1/embeddings
EMBEDDINGS_API_KEY=your-embeddings-key
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_BATCH_SIZE=16

LLM_API_URL=https://api.example.com/v1/chat/completions
LLM_API_KEY=your-llm-key
LLM_MODEL=gpt-4.1-mini

ADE_CRAWL_TIMEOUT_S=12
ADE_MAX_PAGES=200
ADE_CLUSTER_COUNT=0
ADE_LOG_RUN_SUMMARY=true
