FS_AUTH_ENABLED=1
FS_AUTH_MODE=bearer
FS_AUTH_TOKEN=replace-with-a-long-random-token
FS_AUTH_API_KEY=
FS_AUTH_HEADER_NAME=X-FS-API-Key
# Keep empty for a private deployment. Public forms must be enabled one route at a
# time only after their privacy, consent, abuse-prevention, and data-minimisation
# controls have been reviewed.
FS_AUTH_PUBLIC_RULES=

# Organization OIDC mode. Choose one provider explicitly; never configure both.
# Keep the temporary bearer gate disabled except during an approved rollback.
FS_AUTH_EMERGENCY_BEARER_GATE_ENABLED=0
FS_OIDC_PROVIDER=
FS_OIDC_ISSUER=
FS_OIDC_CLIENT_ID=
FS_OIDC_CLIENT_SECRET=
FS_OIDC_REDIRECT_URI=
FS_OIDC_GOOGLE_HOSTED_DOMAIN=
FS_OIDC_ENTRA_TENANT_ID=
FS_OIDC_ENTRA_ALLOW_GUESTS=0
# JSON array of exact-address entries. Use placeholders only in repository files.
FS_ALLOWED_EMAILS_JSON=
FS_FRONTEND_ORIGIN=http://localhost:5174
FS_SESSION_SECRET=
FS_SESSION_COOKIE_NAME=__Host-fs_session
FS_SESSION_COOKIE_SECURE=1
FS_SESSION_COOKIE_SAMESITE=lax
FS_SESSION_IDLE_MINUTES=30
FS_SESSION_ABSOLUTE_HOURS=8
FS_CSRF_HEADER_NAME=X-FS-CSRF

# P0 compliance controls. Purpose and masking enforcement default to on.
FS_PURPOSE_ENFORCEMENT_ENABLED=1
FS_FIELD_MASKING_ENABLED=1
FS_RETENTION_EXECUTION_ENABLED=0
FS_COMPLIANCE_HASH_KEY=
FS_DIRECT_MARKETING_ENFORCEMENT_ENABLED=1
FS_DIRECT_MARKETING_PURPOSE_ID=direct-marketing
# Counsel-controlled: do not enable until election-specific rules are approved.
FS_ELECTION_MARKETING_RULES_ENABLED=0

# Optional Due Diligence connector. Keep this server-side; never send it from the browser.
APIFY_API_TOKEN=
# Master import kill switch. Existing run/dataset/item imports remain enabled by default.
FS_APIFY_FACEBOOK_IMPORT_ENABLED=1
# Managed Actor starts are implemented but fail closed unless explicitly enabled.
FS_APIFY_FACEBOOK_START_ENABLED=0
# Explicit comma-separated identifiers. Both are required for managed starts and deletion.
FS_APIFY_FACEBOOK_ALLOWED_CASES=
FS_APIFY_FACEBOOK_ALLOWED_OPERATORS=
# Hard project controls; both are clamped below the $5 free-plan allowance.
FS_APIFY_FACEBOOK_MAX_RUN_CHARGE_USD=1.00
FS_APIFY_FACEBOOK_MONTHLY_BUDGET_USD=4.50
# Configure this as a custom Apify webhook header. Keep the webhook endpoint behind normal
# FS auth unless you deliberately add only this exact POST route to FS_AUTH_PUBLIC_RULES.
FS_APIFY_FACEBOOK_WEBHOOK_SECRET=
# Destructive expiry cleanup stays off; dry-run cleanup is still available to allowlisted operators.
FS_APIFY_FACEBOOK_RETENTION_DELETE_ENABLED=0

# Used only to create non-reversible, server-side matching keys for personal IDs.
# Raw personal identifiers are never stored or returned by the DD registry adapter.
FS_DD_ID_HASH_KEY=
# Companyinfo's JSON interface is undocumented. Keep disabled until the operator's
# reuse terms/permission are reviewed and explicitly acknowledged.
FS_COMPANYINFO_ENABLED=0
FS_COMPANYINFO_PERMISSION_ACKNOWLEDGED=0
FS_COMPANYINFO_TIMEOUT_SECONDS=12
FS_COMPANYINFO_RETRIES=2
FS_COMPANYINFO_BACKOFF_SECONDS=0.75
FS_COMPANYINFO_MIN_INTERVAL_SECONDS=1
FS_COMPANYINFO_CACHE_HOURS=24
